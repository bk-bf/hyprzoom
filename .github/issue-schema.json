{
  "labels": {
    "required": ["type", "severity"],
    "groups": {
      "type": ["bug", "feature", "chore", "docs", "decision"],
      "severity": ["critical", "high", "medium", "low"]
    },
    "colors": {
      "type": "1d76db",
      "severity": "d93f0b"
    }
  },
  "templates": {
    "bug": "defect.md",
    "feature": "feature.md",
    "decision": "decision.md",
    "*": "task.md"
  },
  "body": {
